#!/usr/bin/env python3
"""westly-ping — the Ping tier: one phone-plain line to the owner, right now.

Telegram first; SMS (carrier email gateway) only when Telegram fails or isn't set up.
Every ping is appended to .attention.log (westly-health reads it for floods) and leaves
an attn- note in the app's feed. Throttled: identical text muted 4h, at most 6 pings an
hour (--force skips both). A throttled ping exits 0: it is not a failure.

  westly-ping "message"
  westly-ping --force "message"
  westly-ping --selftest      offline checks of the pure logic
"""
import sys
import time
from datetime import datetime
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))
import config  # noqa: E402
import sms  # noqa: E402
import tg  # noqa: E402

ATTENTION = REPO / ".attention.log"
OUTBOX = REPO / "memory" / "outbox"
STATE = REPO / ".ping_sent.json"


def record(body, now):
    """Attention log line + feed note; failures here must never stop the ping itself."""
    try:
        with open(ATTENTION, "a") as f:
            f.write(f"{datetime.fromtimestamp(now, config.TZ).isoformat(timespec='seconds')}\t{body}\n")
    except OSError as e:
        print(f"westly-ping: attention log: {e}", file=sys.stderr)
    try:
        OUTBOX.mkdir(parents=True, exist_ok=True)
        (OUTBOX / f"attn-{time.time_ns()}.md").write_text(f"⚠️ {body}\n")
    except OSError as e:
        print(f"westly-ping: feed note: {e}", file=sys.stderr)


def deliver(body, send_tg, send_sms, tg_on, sms_on):
    """(delivered, notes). Telegram first, SMS only as the fallback. Pure apart from the senders."""
    notes = []
    if tg_on:
        try:
            send_tg(f"⚠️ {body}")
            return True, notes + ["telegram"]
        except Exception as e:
            notes.append(f"telegram failed: {e}")
    if sms_on:
        try:
            send_sms(body)
            return True, notes + ["sms"]
        except Exception as e:
            notes.append(f"sms failed: {e}")
    if not tg_on and not sms_on:
        notes.append("no ping channel configured (TELEGRAM_* or SMS_TO in westly.env); feed note only")
    return False, notes


def main(args):
    force = bool(args) and args[0] == "--force"
    body = " ".join(" ".join(args[1:] if force else args).split())
    if not body:
        print('usage: westly-ping [--force] "message"', file=sys.stderr)
        return 2
    now = time.time()
    record(body, now)
    if not force:
        allowed, why = sms.throttle(body, now, STATE)
        if not allowed:
            print(f"westly-ping: not sent ({why})", file=sys.stderr)
            return 0
    creds = tg.creds()
    ok, notes = deliver(body, tg.send, lambda b: sms.send(b, force=True),
                        bool(creds and creds[1]), bool(config.get("SMS_TO")))
    for n in notes[:-1] if ok else notes:
        print(f"westly-ping: {n}", file=sys.stderr)
    if ok:
        print(f"westly-ping: sent via {notes[-1]}")
    return 0 if ok else 1


def selftest():
    sent = []

    def good(b):
        sent.append(b)

    def bad(b):
        raise RuntimeError("down")
    assert deliver("x", good, bad, True, True) == (True, ["telegram"]) and sent == ["⚠️ x"]
    sent.clear()
    ok, notes = deliver("x", bad, good, True, True)
    assert ok and notes[-1] == "sms" and "telegram failed" in notes[0] and sent == ["x"], notes
    assert deliver("x", good, good, False, True)[1] == ["sms"]
    ok, notes = deliver("x", bad, bad, True, True)
    assert not ok and len(notes) == 2, notes
    ok, notes = deliver("x", good, good, False, False)
    assert not ok and "no ping channel" in notes[0], notes
    tg.selftest()
    sms.selftest()
    print("PASS")
    return 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--selftest"]:
        sys.exit(selftest())
    sys.exit(main(sys.argv[1:]))

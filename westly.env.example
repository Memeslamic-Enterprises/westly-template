# westly.env — every setting in one place. setup.py writes the real file (mode 0600, gitignored).
# Format: KEY=value, one per line, no spaces around '='. Blank = unset / default.
# After editing: systemctl --user restart westly-bot

# ---------- identity ----------
# Your name, as the assistant and the app address you (letters, digits, spaces, hyphens; max 32).
OWNER_NAME=
# The assistant's name; shown in the app and used in its persona.
ASSISTANT_NAME=Westly
# IANA time zone for briefs and the app (e.g. America/New_York). Blank = the server's zone.
TIMEZONE=

# ---------- Claude ----------
# Model for chat and scheduled runs (sonnet, opus, haiku, or a full model id).
WESTLY_MODEL=sonnet
# Path to the claude CLI. Blank = first `claude` on PATH, else ~/.local/bin/claude.
CLAUDE_BIN=
# Optional Anthropic API key used ONLY when the subscription login has expired or hit its limit.
WESTLY_API_KEY=

# ---------- the phone app ----------
# Your Tailscale login (the email you sign in to Tailscale with). Only this identity may use the app;
# blank = the app refuses every request.
PDA_LOGIN=
# The app's public address as `tailscale serve` prints it, e.g. https://myserver.tailnet-name.ts.net:8443
# Used for the cross-site check on POSTs and for links printed by bin/westly-doc.
PUBLIC_URL=

# ---------- chat channels (optional; the app always works) ----------
# Telegram: create a bot with @BotFather, paste its token, send it one message, then run setup.py
# again (it finds your chat id). Only messages from TELEGRAM_CHAT_ID are answered.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: a bot token (Message Content intent on). Only DMs from OWNER_ID (your Discord user id)
# are answered; blank OWNER_ID = learned from the only human sharing a server with the bot.
DISCORD_TOKEN=
OWNER_ID=

# ---------- pings: SMS fallback (optional, US carriers) ----------
# Comma-separated number@carrier, e.g. 2125550123@verizon (carriers: see sms.py GATEWAYS).
# Sent through the MAIL_* SMTP account below.
SMS_TO=

# ---------- mail (optional; read-only IMAP triage + the SMTP account for SMS) ----------
MAIL_USER=
# An app password, never your main password.
MAIL_PASSWORD=
# Your provider's servers, e.g. imap.example.com / smtp.example.com (465 = TLS, 587 = STARTTLS).
MAIL_IMAP_HOST=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
# Comma-separated sender substrings left out of the mail digest (mail another tool handles).
MAIL_SKIP_FROM=

# ---------- Google Calendar (optional; see prompts/gcal-setup.md) ----------
# Service-account key file; relative paths are inside this directory.
GCAL_KEY=gcal-sa.json
# Calendar IDs (…@group.calendar.google.com). MAIN = the assistant's calendar; SHARED = optional.
GCAL_MAIN=
GCAL_SHARED=
# How the app labels them.
GCAL_MAIN_LABEL=Me
GCAL_SHARED_LABEL=Shared

# ---------- morning brief timing ----------
# On days with a timed event on BRIEF_CALENDAR (a calendar key above: main or shared), the brief
# fires BRIEF_LEAD_H hours before the first one; otherwise (or with BRIEF_CALENDAR blank) at BRIEF_TIME.
BRIEF_TIME=07:45
BRIEF_LEAD_H=2
BRIEF_CALENDAR=

# ---------- weather (optional; Open-Meteo, no key needed) ----------
WEATHER_LAT=
WEATHER_LON=
# Label in the app's weather sheet, e.g. Chicago.
WEATHER_PLACE=
# imperial (°F, mph) or metric (°C, km/h).
WEATHER_UNITS=imperial
# 1 = also show US National Weather Service alerts (US locations only).
WEATHER_NWS_ALERTS=0

# ---------- other integrations (optional) ----------
# Home Assistant: base URL and a long-lived access token.
HA_URL=
HA_TOKEN=
# Machines the health check pings over ssh (key auth), comma-separated user@host.
HEALTH_SSH_HOSTS=
